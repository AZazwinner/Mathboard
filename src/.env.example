# Copy to .env and fill in. Never commit the real .env (already gitignored).

# JWT signing key. Generate a fresh one for production - don't reuse a dev
# key, and don't reuse this one across environments: `openssl rand -hex 32`
SECRET_KEY=

# Postgres is the supported database: postgresql://user:password@host:5432/mathboard
# (postgres:// is accepted too). Percent-encode special characters in the password.
# sqlite:///./mathboard.db still works for quick local runs and tests, but it is
# single-process only, so it cannot back more than one backend replica.
DATABASE_URL=postgresql://mathboard:change-me@localhost:5432/mathboard

# Optional. Valkey (or Redis) is what lets several backend replicas serve the same
# documents: it carries live edits and cursors between them and holds the shared
# login rate limits. Without it a single backend process works exactly as before,
# but two replicas would each only see their own edits until the next database flush.
# VALKEY_URL=redis://localhost:6379/0

# Optional. Seconds between each live document checking Postgres for edits other
# replicas have saved. This is the fallback path if Valkey is down. 0 disables it.
# YROOM_RECONCILE_SECONDS=10

# Optional. Postgres connection pool per backend process (defaults shown). Keep
# replicas * (DB_POOL_SIZE + DB_MAX_OVERFLOW) under Postgres's max_connections.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Optional. If set, the test suite runs against this Postgres database instead of
# a temporary SQLite file, and builds the schema with Alembic. The database name
# must contain "test": the suite drops and recreates the public schema.
# TEST_DATABASE_URL=postgresql://mathboard:change-me@localhost:5432/mathboard_test

# Optional. If set, the suite also runs the Valkey-backed tests (multi-replica sync,
# shared rate limits). Only keys starting with "mb:" are ever deleted.
# TEST_VALKEY_URL=redis://localhost:6379/1

# The frontend's own URL - used to build password-reset links
# (APP_URL + "/reset-password?token=..."). http://localhost:12000 in dev,
# the real Vercel URL in production.
APP_URL=http://localhost:12000

# Comma-separated list of CORS origins to allow, on top of the localhost dev
# origins hardcoded in main.py. Set this to your production frontend's actual
# URL(s), e.g. https://mathboardx.vercel.app
CORS_ORIGINS=

# Optional. Password-reset emails go out over plain SMTP once SMTP_HOST, SMTP_USER
# and SMTP_PASSWORD are all set (see mailer.py). Until then the reset link is only
# logged server-side, so a reset has to be done by hand from the log.
#
# Gmail works without owning a domain: turn on 2-Step Verification, create an App
# Password at https://myaccount.google.com/apppasswords, and use it below. Use a
# dedicated Gmail account for this, not your personal one: an app password grants
# access to the whole account.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-mathboard-account@gmail.com
# SMTP_PASSWORD=
# Optional. Defaults to SMTP_USER. Gmail rewrites the address but keeps the name.
# SMTP_FROM=Mathboard <your-mathboard-account@gmail.com>

# Local dev only. With SMTP unconfigured, also return the reset link in the
# /forgot-password response. NEVER set this on a server anyone else can reach:
# it lets anyone reset the password of any registered email.
# ALLOW_DEV_RESET_LINK=1
