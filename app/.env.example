# Copy to .env.local and fill in for local dev, or set these as real
# environment variables in your deploy platform's dashboard (Vercel project
# settings). All three are NEXT_PUBLIC_ - they're baked into the client
# bundle at build time, so never put a secret in one.

# The backend's own URL. http://localhost:12001 in dev; the real Render
# service URL in production (https://<service>.onrender.com).
NEXT_PUBLIC_API_URL=http://localhost:12001

# Same backend, but the WebSocket scheme - ws:// in dev, wss:// in production
# (https://<service>.onrender.com -> wss://<service>.onrender.com).
NEXT_PUBLIC_WS_URL=ws://localhost:12001

# This frontend's own URL. http://localhost:12000 in dev; the real Vercel
# domain in production. Used for metadata (canonical/OG/sitemap) and for
# building share links.
NEXT_PUBLIC_APP_URL=http://localhost:12000
